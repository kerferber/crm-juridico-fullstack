{
  "name": "crm/laravel-backend",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.7",
    "laravel/sanctum": "^4.0",
    "doctrine/dbal": "^3.6"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "phpunit/phpunit": "^11.0",
    "laravel/pint": "^1.14"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}