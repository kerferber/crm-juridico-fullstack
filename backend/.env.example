APP_NAME=CRMBackend
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_backend
DB_USERNAME=root
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=reverb
FILESYSTEM_DISK=local

DISABLE_API_AUTH=false

ADMIN_PANEL_EMAIL=fernandokerber@gmail.com
ADMIN_PANEL_PASSWORD=admin123
ADMIN_PANEL_TOKEN_TTL=60

REVERB_APP_ID=crm-reverb-app
REVERB_APP_KEY=local
REVERB_APP_SECRET=local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_USE_TLS=false
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_CLUSTER=mt1
